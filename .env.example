# ====== GOOGLE OAUTH ======
# Google Client ID para autenticação
# Obter em: https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=""

# ====== API CONFIGURATION ======
# URL do Backend API (mesma porta que PORT no Back_End/.env)
# Desenvolvimento: http://localhost:3001/api  OU use só "/api" para passar pelo proxy do Vite
# Produção no Render: https://seu-backend-id.onrender.com/api
VITE_API_URL="http://localhost:3001/api"
